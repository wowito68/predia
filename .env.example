# ============================================
# .env.example
# ============================================
# Template de variables de entorno para PREDIA.
# Copiar este archivo a .env (desarrollo) o .env.production (producción)
# y completar con los valores reales.

# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV="development" # development | production
PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ============================================
# DATABASE (MySQL)
# ============================================
# Formato: mysql://usuario:password@host:puerto/nombre_bd
DATABASE_URL="mysql://predia_user:secure_password@localhost:3306/predia_db"

# Para Docker Compose (desarrollo)
# DATABASE_URL="mysql://root:root@localhost:3306/predia"

# ============================================
# SECURITY (JWT)
# ============================================
# Genera uno seguro con: openssl rand -base64 32
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="predia-api"
JWT_AUDIENCE="predia-clients"

# Cifrado reversible AES-256-GCM para campos sensibles recuperables.
# Generar con: openssl rand -base64 32
PREDIA_ENCRYPTION_KEY="CHANGE_THIS_BASE64_32_BYTE_KEY"

# ============================================
# RESEND (Email)
# ============================================
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
# URL de la aplicación (usado en enlaces de emails)
APP_URL="http://localhost:3000"
# Remitente de emails — debe coincidir con dominio verificado en Resend
# Para desarrollo: onboarding@resend.dev
FROM_EMAIL="onboarding@resend.dev"

# ============================================
# CORS & COOKIES
# ============================================
ALLOWED_ORIGINS="http://localhost:3000,https://tu-dominio.com"
SECURE_COOKIES="false" # true en producción con HTTPS
COOKIE_DOMAIN="localhost"
PREDIA_INSTANCE_ID="predia-local-1"

# ============================================
# OPTIONAL SERVICES
# ============================================
# Logging
LOG_LEVEL="info"

# SMTP (Email)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASSWORD="app-password"
# SMTP_FROM="PREDIA <noreply@predia.com>"
