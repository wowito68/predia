# ============================================
# env.template
# ============================================
# Template de variables de entorno para PREDIA
# Copiar a .env y completar con valores reales

# ============================================
# Base de Datos
# ============================================
DATABASE_URL="mysql://usuario:password@localhost:3306/predia"

# Ejemplo para AWS RDS:
# DATABASE_URL="mysql://admin:SecurePass123@predia-db.xxxxx.us-east-1.rds.amazonaws.com:3306/predia"

# ============================================
# Autenticación JWT
# ============================================
JWT_SECRET="CAMBIAR_ESTO_POR_UNA_CLAVE_SEGURA"
JWT_EXPIRES_IN="24h"

# Genera una clave segura con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ============================================
# Configuración
# ============================================
NODE_ENV="production"
NEXT_PUBLIC_API_URL="https://tu-dominio.com"
PORT=3000
