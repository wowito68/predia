                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Registrar Riesgo Bajo": {
            "main": [
                [
                    {
                        "node": "Responder al Webhook",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
