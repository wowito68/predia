{
  "name": "predia-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "web:dev": "pnpm --filter @predia/web dev",
    "web:build": "pnpm --filter @predia/web build",
    "web:start": "pnpm --filter @predia/web start",
    "web:test": "pnpm --filter @predia/web test",
    "mobile:dev": "pnpm --filter @predia/mobile start",
    "mobile:android": "pnpm --filter @predia/mobile android",
    "mobile:ios": "pnpm --filter @predia/mobile ios",
    "db:migrate": "pnpm --filter @predia/web db:migrate",
    "db:seed": "pnpm --filter @predia/web db:seed",
    "db:studio": "pnpm --filter @predia/web prisma:studio",
    "setup": "bash setup.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
