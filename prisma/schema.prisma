generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id_rol      Int       @id @default(autoincrement())
  nombre_rol  String    @unique @db.VarChar(50)
  descripcion String?   @db.Text
  activo      Boolean   @default(true)
  usuarios    Usuario[]

  @@map("rol")
}

model Usuario {
  id_usuario             Int                      @id @default(autoincrement())
  username               String                   @unique @db.VarChar(100)
  password_hash          String                   @db.VarChar(255)
  id_rol                 Int
  nombre                 String                   @db.VarChar(100)
  apellido_paterno       String                   @db.VarChar(100)
  apellido_materno       String?                  @db.VarChar(100)
  email                  String                   @unique @db.VarChar(100)
  telefono               String?                  @db.VarChar(20)
  cedula_profesional     String?                  @unique @db.VarChar(50)
  especialidad           String?                  @db.VarChar(100)
  activo                 Boolean                  @default(true)
  ultimo_acceso          DateTime?
  fecha_registro         DateTime                 @default(now())
  fecha_modificacion     DateTime?                @default(now()) @updatedAt
  // Relaciones existentes
  auditoria              auditoria[]
  estudios               EstudioLaboratorio[]
  historiales            HistorialClinico[]
  mediciones             MedicionAntropometrica[]
  predicciones           Prediccion[]
  rol                    Rol                      @relation(fields: [id_rol], references: [id_rol])
  // Nuevas relaciones - Historial Clínico
  vacunasAplicadas       VacunaAplicada[]
  patologiasDiagnosticadas PatologiaPaciente[]
  consultasRealizadas    ConsultaMedica[]
  imagenesRegistradas    ImagenDiagnostica[]
  fracturasRegistradas   Fractura[]
  alergiasRegistradas    Alergia[]
  antecedentesRegistrados AntecedenteFamiliar[]

  @@index([id_rol], map: "usuario_id_rol_fkey")
  @@map("usuario")
}

model Direccion {
  id_direccion  Int        @id @default(autoincrement())
  calle         String     @db.VarChar(255)
  numero        String?    @db.VarChar(20)
  apartamento   String?    @db.VarChar(20)
  ciudad        String     @db.VarChar(100)
  provincia     String     @db.VarChar(100)
  codigo_postal String?    @db.VarChar(10)
  pais          String     @db.VarChar(100)
  pacientes     Paciente[]

  @@map("direccion")
}

model Paciente {
  id_paciente            Int                      @id @default(autoincrement())
  cedula                 String                   @unique @db.VarChar(50)
  nombre                 String                   @db.VarChar(100)
  apellido_paterno       String                   @db.VarChar(100)
  apellido_materno       String?                  @db.VarChar(100)
  genero                 String                   @db.VarChar(10)
  fecha_nacimiento       DateTime
  edad                   Int?
  telefono               String?                  @db.VarChar(20)
  email                  String?                  @db.VarChar(100)
  id_direccion           Int?
  foto_perfil            String?                  @db.Text
  activo                 Boolean                  @default(true)
  fecha_registro         DateTime                 @default(now())
  fecha_modificacion     DateTime?                @default(now()) @updatedAt
  // Relaciones existentes
  estudios               EstudioLaboratorio[]
  historiales            HistorialClinico[]
  mediciones             MedicionAntropometrica[]
  direccion              Direccion?               @relation(fields: [id_direccion], references: [id_direccion])
  predicciones           Prediccion[]
  // Nuevas relaciones - Historial Clínico
  vacunas                VacunaAplicada[]
  patologias             PatologiaPaciente[]
  consultas              ConsultaMedica[]
  imagenes               ImagenDiagnostica[]
  fracturas              Fractura[]
  alergias               Alergia[]
  antecedentesFamiliares AntecedenteFamiliar[]

  @@index([id_direccion], map: "paciente_id_direccion_fkey")
  @@map("paciente")
}

model EstudioLaboratorio {
  id_estudio         Int          @id @default(autoincrement())
  id_paciente        Int
  id_usuario         Int
  fecha_estudio      DateTime     @default(now())
  urea               Float?
  creatinina         Float?
  hba1c              Float?
  glucosa_ayunas     Float?
  colesterol_total   Float?
  trigliceridos      Float?
  hdl                Float?
  ldl                Float?
  vldl               Float?
  observaciones      String?      @db.Text
  archivo_pdf        String?      @db.VarChar(255)
  activo             Boolean      @default(true)
  fecha_registro     DateTime     @default(now())
  fecha_modificacion DateTime?    @default(now()) @updatedAt
  paciente           Paciente     @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario            Usuario      @relation(fields: [id_usuario], references: [id_usuario])
  predicciones       Prediccion[]

  @@index([id_paciente], map: "estudio_laboratorio_id_paciente_fkey")
  @@index([id_usuario], map: "estudio_laboratorio_id_usuario_fkey")
  @@map("estudio_laboratorio")
}

model MedicionAntropometrica {
  id_medicion            Int          @id @default(autoincrement())
  id_paciente            Int
  id_usuario             Int
  fecha_medicion         DateTime     @default(now())
  peso                   Float?
  altura                 Float?
  imc                    Float?
  circunferencia_cintura Float?
  circunferencia_cadera  Float?
  presion_sistolica      Int?
  presion_diastolica     Int?
  observaciones          String?      @db.Text
  activo                 Boolean      @default(true)
  fecha_registro         DateTime     @default(now())
  fecha_modificacion     DateTime?    @default(now()) @updatedAt
  paciente               Paciente     @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario                Usuario      @relation(fields: [id_usuario], references: [id_usuario])
  predicciones           Prediccion[]

  @@index([id_paciente], map: "medicion_antropometrica_id_paciente_fkey")
  @@index([id_usuario], map: "medicion_antropometrica_id_usuario_fkey")
  @@map("medicion_antropometrica")
}

model ModeloIA {
  id_modelo           Int          @id @default(autoincrement())
  version             String       @unique @db.VarChar(50)
  fecha_entrenamiento DateTime
  accuracy            Float
  n_samples_train     Int
  n_samples_test      Int
  features            String       @db.Text
  feature_importance  String?      @db.Text
  descripcion         String?      @db.Text
  archivo_modelo      String?      @db.VarChar(255)
  activo              Boolean      @default(true)
  fecha_registro      DateTime     @default(now())
  predicciones        Prediccion[]

  @@map("modelo_ia")
}

model Prediccion {
  id_prediccion            Int                     @id @default(autoincrement())
  id_paciente              Int
  id_usuario               Int
  id_modelo                Int
  id_estudio               Int?
  id_medicion              Int?
  fecha_prediccion         DateTime                @default(now())
  datos_entrada            String                  @db.Text
  resultado                String                  @db.VarChar(50)
  probabilidad_diabetes    Float
  probabilidad_no_diabetes Float
  nivel_riesgo             String                  @db.VarChar(50)
  factores_riesgo          String?                 @db.Text
  recomendaciones          String?                 @db.Text
  validado                 Boolean                 @default(false)
  diagnostico_confirmado   String                  @default("Pendiente") @db.VarChar(50)
  notas_medicas            String?                 @db.Text
  fecha_validacion         DateTime?
  fecha_registro           DateTime                @default(now())
  fecha_modificacion       DateTime?               @default(now()) @updatedAt
  estudio                  EstudioLaboratorio?     @relation(fields: [id_estudio], references: [id_estudio])
  medicion                 MedicionAntropometrica? @relation(fields: [id_medicion], references: [id_medicion])
  modelo                   ModeloIA                @relation(fields: [id_modelo], references: [id_modelo])
  paciente                 Paciente                @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario                  Usuario                 @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_estudio], map: "prediccion_id_estudio_fkey")
  @@index([id_medicion], map: "prediccion_id_medicion_fkey")
  @@index([id_modelo], map: "prediccion_id_modelo_fkey")
  @@index([id_paciente], map: "prediccion_id_paciente_fkey")
  @@index([id_usuario], map: "prediccion_id_usuario_fkey")
  @@map("prediccion")
}

model HistorialClinico {
  id_historial   Int      @id @default(autoincrement())
  id_paciente    Int
  id_usuario     Int
  fecha_registro DateTime @default(now())
  tipo_evento    String   @db.VarChar(50)
  descripcion    String   @db.Text
  diagnostico    String?  @db.Text
  tratamiento    String?  @db.Text
  observaciones  String?  @db.Text
  paciente       Paciente @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario        Usuario  @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente], map: "historial_clinico_id_paciente_fkey")
  @@index([id_usuario], map: "historial_clinico_id_usuario_fkey")
  @@map("historial_clinico")
}

model auditoria {
  id_auditoria   Int       @id @default(autoincrement())
  id_usuario     Int
  accion         String    @db.VarChar(100)
  detalles       String?   @db.VarChar(500)
  resultado      String?   @db.VarChar(20)
  fecha_registro DateTime? @default(now()) @db.Timestamp(0)
  usuario        Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: Restrict, map: "auditoria_ibfk_1")

  @@index([fecha_registro], map: "idx_fecha")
  @@index([id_usuario], map: "idx_usuario")
}

// ========================================
// SISTEMA DE HISTORIALES CLÍNICOS
// ========================================

// Catálogo de vacunas disponibles
model CatalogoVacuna {
  id_vacuna        Int              @id @default(autoincrement())
  nombre           String           @db.VarChar(100)
  descripcion      String?          @db.Text
  dosis_requeridas Int              @default(1)
  activo           Boolean          @default(true)
  fecha_registro   DateTime         @default(now())
  aplicaciones     VacunaAplicada[]

  @@map("catalogo_vacuna")
}

// Vacunas aplicadas a pacientes
model VacunaAplicada {
  id_aplicacion    Int            @id @default(autoincrement())
  id_paciente      Int
  id_vacuna        Int
  id_usuario       Int
  fecha_aplicacion DateTime
  dosis_numero     Int            @default(1)
  lote             String?        @db.VarChar(50)
  observaciones    String?        @db.Text
  fecha_registro   DateTime       @default(now())
  paciente         Paciente       @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  vacuna           CatalogoVacuna @relation(fields: [id_vacuna], references: [id_vacuna])
  usuario          Usuario        @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente])
  @@index([id_vacuna])
  @@index([id_usuario])
  @@map("vacuna_aplicada")
}

// Catálogo de patologías (CIE-10)
model CatalogoPatologia {
  id_patologia   Int                 @id @default(autoincrement())
  codigo_cie10   String?             @unique @db.VarChar(10)
  nombre         String              @db.VarChar(200)
  descripcion    String?             @db.Text
  categoria      String?             @db.VarChar(100)
  activo         Boolean             @default(true)
  fecha_registro DateTime            @default(now())
  diagnosticos   PatologiaPaciente[]

  @@map("catalogo_patologia")
}

// Patologías diagnosticadas al paciente
model PatologiaPaciente {
  id_diagnostico    Int               @id @default(autoincrement())
  id_paciente       Int
  id_patologia      Int
  id_usuario        Int
  fecha_diagnostico DateTime
  estado            String            @default("Activa") @db.VarChar(30)
  severidad         String?           @db.VarChar(30)
  notas             String?           @db.Text
  fecha_registro    DateTime          @default(now())
  paciente          Paciente          @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  patologia         CatalogoPatologia @relation(fields: [id_patologia], references: [id_patologia])
  usuario           Usuario           @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente])
  @@index([id_patologia])
  @@index([id_usuario])
  @@map("patologia_paciente")
}

// Consultas médicas / Visitas
model ConsultaMedica {
  id_consulta        Int       @id @default(autoincrement())
  id_paciente        Int
  id_usuario         Int
  fecha_consulta     DateTime  @default(now())
  motivo_consulta    String    @db.Text
  sintomas           String?   @db.Text
  exploracion_fisica String?   @db.Text
  diagnostico        String?   @db.Text
  tratamiento        String?   @db.Text
  receta             String?   @db.Text
  proxima_cita       DateTime?
  observaciones      String?   @db.Text
  fecha_registro     DateTime  @default(now())
  paciente           Paciente  @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario            Usuario   @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente])
  @@index([id_usuario])
  @@map("consulta_medica")
}

// Imágenes diagnósticas (radiografías, ultrasonidos, etc.)
model ImagenDiagnostica {
  id_imagen        Int      @id @default(autoincrement())
  id_paciente      Int
  id_usuario       Int
  fecha_estudio    DateTime @default(now())
  tipo_imagen      String   @db.VarChar(50)
  region_anatomica String   @db.VarChar(100)
  archivo_data     Bytes?   @db.LongBlob
  archivo_nombre   String?  @db.VarChar(255)
  archivo_tipo     String?  @db.VarChar(100)
  informe          String?  @db.Text
  hallazgos        String?  @db.Text
  conclusion       String?  @db.Text
  fecha_registro   DateTime @default(now())
  paciente         Paciente @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario          Usuario  @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente])
  @@index([id_usuario])
  @@map("imagen_diagnostica")
}

// Fracturas
model Fractura {
  id_fractura    Int       @id @default(autoincrement())
  id_paciente    Int
  id_usuario     Int
  fecha_fractura DateTime
  hueso_afectado String    @db.VarChar(100)
  tipo_fractura  String?   @db.VarChar(100)
  lado           String?   @db.VarChar(20)
  causa          String?   @db.Text
  tratamiento    String?   @db.Text
  estado         String    @default("En tratamiento") @db.VarChar(30)
  fecha_alta     DateTime?
  observaciones  String?   @db.Text
  fecha_registro DateTime  @default(now())
  paciente       Paciente  @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario        Usuario   @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente])
  @@index([id_usuario])
  @@map("fractura")
}

// Alergias del paciente
model Alergia {
  id_alergia      Int       @id @default(autoincrement())
  id_paciente     Int
  id_usuario      Int
  tipo_alergia    String    @db.VarChar(50)
  alergeno        String    @db.VarChar(200)
  severidad       String?   @db.VarChar(30)
  reaccion        String?   @db.Text
  fecha_deteccion DateTime?
  activa          Boolean   @default(true)
  fecha_registro  DateTime  @default(now())
  paciente        Paciente  @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario         Usuario   @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente])
  @@index([id_usuario])
  @@map("alergia")
}

// Antecedentes familiares
model AntecedenteFamiliar {
  id_antecedente Int      @id @default(autoincrement())
  id_paciente    Int
  id_usuario     Int
  parentesco     String   @db.VarChar(50)
  condicion      String   @db.VarChar(200)
  detalles       String?  @db.Text
  fecha_registro DateTime @default(now())
  paciente       Paciente @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
  usuario        Usuario  @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_paciente])
  @@index([id_usuario])
  @@map("antecedente_familiar")
}

