{
  "uid": "predia-overview",
  "title": "PREDIA - Salud del sistema",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "API up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(predia_app_up)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 8 },
      "targets": [{ "expr": "sum by (route,status) (rate(predia_http_requests_total[5m]))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Auth failures",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 8 },
      "targets": [{ "expr": "sum by (role) (increase(predia_auth_attempts_total{result=\"failure\"}[5m]))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Memory RSS",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "predia_process_memory_bytes{type=\"rss\"}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Container CPU",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"predia.*\"}[5m]))", "refId": "A" }]
    }
  ],
  "time": { "from": "now-30m", "to": "now" }
}

