{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(245, 158, 11, 1)",
        "name": "Alerts and annotations",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "API publica",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "max(up{job=\"predia-api\"})", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Disponibilidad publica",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "CAIDA" },
                "1": { "color": "green", "text": "OPERATIVA" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "min(probe_success{job=\"blackbox-https\"})", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "MySQL",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "NO DISPONIBLE" },
                "1": { "color": "green", "text": "DISPONIBLE" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "max(probe_success{job=\"blackbox-mysql\"})", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "TLS restante",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "d",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min((probe_ssl_earliest_cert_expiry{job=\"blackbox-https\"} - time()) / 86400)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Disco libre minimo",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.15 },
              { "color": "green", "value": 0.3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memoria del VPS",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.75 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Actividad del monitoreo",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(prometheus_http_requests_total[1m]))",
          "legendFormat": "consultas/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia de endpoints publicos",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox-https\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Codigos HTTP publicos",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "probe_http_status_code{job=\"blackbox-https\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU servidor privado - demo en vivo",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memoria servidor privado",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "memoria usada",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia de conexion MySQL",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox-mysql\"}",
          "legendFormat": "conexion TCP",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tiempo de recopilacion de la API",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "scrape_duration_seconds{job=\"predia-api\"}",
          "legendFormat": "scrape API",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fallos de autenticacion",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (role) (increase(predia_auth_attempts_total{result=\"failure\"}[5m]))",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["predia", "produccion", "salud"],
  "templating": { "list": [] },
  "time": { "from": "now-5m", "to": "now" },
  "timezone": "browser",
  "title": "PREDIA - Salud del sistema",
  "uid": "predia-overview",
  "version": 3
}
