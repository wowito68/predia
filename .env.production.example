NODE_ENV=production
PORT=3000

# Dominio publico. No incluyas protocolo en PREDIA_DOMAIN.
PREDIA_DOMAIN=predia.example.com
APP_URL=https://predia.example.com
NEXT_PUBLIC_API_URL=https://predia.example.com/api
EXPO_PUBLIC_API_URL=https://predia.example.com/api

# MySQL dentro de docker-compose.production.yml.
# Si la contrasena contiene caracteres reservados, codificala en DATABASE_URL.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_24_CHARS
MYSQL_DATABASE=predia_db
MYSQL_USER=predia_app
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD_24_CHARS
MYSQL_EXPORTER_PASSWORD=CHANGE_ME_EXPORTER_PASSWORD_24_CHARS
DATABASE_URL=mysql://predia_app:CHANGE_ME_APP_PASSWORD_24_CHARS@db:3306/predia_db

# Autenticacion y cifrado. Genera valores independientes.
# JWT_SECRET: openssl rand -base64 48
# PREDIA_ENCRYPTION_KEY: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_MINIMUM_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=predia-api
JWT_AUDIENCE=predia-clients
PREDIA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Navegador, CORS y cookies.
ALLOWED_ORIGINS=https://predia.example.com
SECURE_COOKIES=true
COOKIE_DOMAIN=predia.example.com

# Certificado y despliegue.
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot
SEED_DEMO_DATA=false
# Obligatorias solo cuando SEED_DEMO_DATA=true.
DEMO_USER_PASSWORD=CHANGE_ME_DEMO_PASSWORD_16_CHARS
DEMO_PATIENT_PIN=CHANGE_ME_6_DIGIT_PIN

# Monitoreo solo accesible por loopback/SSH tunnel.
GRAFANA_ADMIN_USER=predia_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_24_CHARS
LOG_LEVEL=info

# Opcional: habilita transcripcion real. Sin esta variable se usa el modo demo.
# OPENAI_API_KEY=sk-...
